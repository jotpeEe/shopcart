{
    "name": "shopcart",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "docker-compose up -d && next dev",
        "build:prod": "cp .env.production .env.local && next build",
        "build:dev": "cp .env.development .env.local && next build",
        "build:analitics": "ANALYZE=true next build",
        "start": "next start",
        "studio": "dotenv -e .env.development prisma studio",
        "initDB": "dotenv -e .env.development prisma db push && prisma generate",
        "migrateDB": "dotenv -e .env.development prisma migrate dev && prisma generate",
        "lint": "next lint --fix src",
        "format": "prettier --write .",
        "test": "SKIP_ENV_VALIDATION=true jest",
        "test:watch": "SKIP_ENV_VALIDATION=true jest --watch"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.0.0",
        "@hookform/resolvers": "^3.3.4",
        "@prisma/client": "^5.12.1",
        "@radix-ui/react-dropdown-menu": "^2.0.6",
        "@radix-ui/react-label": "^2.0.2",
        "@radix-ui/react-slot": "^1.0.2",
        "@radix-ui/react-toast": "^1.1.5",
        "@t3-oss/env-nextjs": "^0.10.1",
        "bcrypt": "^5.1.1",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "embla-carousel-react": "^8.0.2",
        "framer-motion": "^11.1.5",
        "geist": "^1.3.0",
        "lucide-react": "^0.371.0",
        "next": "14.2.2",
        "next-auth": "^4.24.7",
        "next-intl": "^3.11.3",
        "next-themes": "^0.3.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.51.3",
        "tailwind-merge": "^2.2.2",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^14.2.2",
        "@playwright/test": "^1.43.1",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^15.0.2",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.12.7",
        "@types/react": "^18.2.79",
        "@types/react-dom": "^18.2.25",
        "@typescript-eslint/eslint-plugin": "^7.7.0",
        "@typescript-eslint/parser": "^7.7.0",
        "autoprefixer": "^10.4.19",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.0.4",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jest-dom": "^5.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-testing-library": "^6.2.0",
        "eslint-plugin-unused-imports": "^3.0.0",
        "husky": "^9.0.11",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^15.2.2",
        "postcss": "^8.4.38",
        "prettier": "^3.2.5",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "prisma": "^5.12.1",
        "tailwindcss": "^3.4.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    }
}
